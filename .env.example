# Copier ce fichier en .env (jamais versionné).

# --- OSRM (optionnel) ---
# Serveur public par défaut : https://router.project-osrm.org (usage modéré, sans garantie).
# Pour un serveur OSRM personnel :
# OSRM_BASE_URL=http://localhost:5000
# OSRM_PROFILE=driving

# --- Gemini (bouton 3 : agents IA) ---
# Clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : forcer un modèle (sinon sélection automatique du premier disponible)
# GEMINI_MODEL=gemini-3.6-flash

# Backend Keras pour BC3 KerasTuner (appli ACO) : torch (conseillé), jax ou tensorflow.
# Sans valeur, l'appli prend le premier installé dans cet ordre.
KERAS_BACKEND=torch
